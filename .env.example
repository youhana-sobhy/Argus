# ---------------------------------------------------------------
# Argus configuration. Copy to .env and adjust.
# ---------------------------------------------------------------

# Session signing key. CHANGE THIS outside of a local demo.
ARGUS_SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite for the demo; Postgres-ready)
ARGUS_DATABASE_URL=sqlite:///./runtime/argus.db
# ARGUS_DATABASE_URL=postgresql+psycopg://argus:argus@db:5432/argus

# Where runtime state (mock lab state, DB) is written
ARGUS_RUNTIME_DIR=./runtime

# ---------------- Connector ----------------
# mock  = built-in Cisco ACI mock lab (default, safe)
# apic  = real Cisco APIC REST API
ARGUS_CONNECTOR=mock
ARGUS_APIC_URL=https://apic.example.local
ARGUS_APIC_USERNAME=
ARGUS_APIC_PASSWORD=
ARGUS_APIC_VERIFY_TLS=true
# Safety switch: execution against a REAL fabric is blocked unless this is true.
ARGUS_ALLOW_LIVE_EXECUTION=false

# ---------------- AI provider ----------------
# mock      = offline assistant, no data leaves the host (default)
# anthropic = Claude via the Anthropic API
# azure     = Azure OpenAI (set the AZURE_* values below)
ARGUS_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ARGUS_ANTHROPIC_MODEL=claude-opus-5-5
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Mask IPs, serials and secrets before anything is sent to an LLM
ARGUS_REDACT=true

# ---------------- Demo users ----------------
# Password used to seed the demo users (admin, engineer, approver, viewer)
ARGUS_DEMO_PASSWORD=Argus-Demo-2026
